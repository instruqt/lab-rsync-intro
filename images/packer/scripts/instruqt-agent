#!/bin/bash
# Copyright (C) 2026, Instruqt. All Rights Reserved.

set -euxo pipefail

function setup_fail () {
    echo "##### SETUP FAIL #####" "$@"
    exit 1
}

# Perform the following actions to start the Instruqt agent, zero
# out /etc/machine-id, and remove any ssh host keys generated by
# the build process. For Red Hat systems, you also need to do some
# stuff around selinux, but we don't need that for the Debian
# images we're building.
#
# See instruqt/lab-sdk/build/images/bootstrap.sh for more guidance

## Install instruqt-agent service file
## Packer leaves /tmp/instruqt-agent.service by this point
install -o root -g root -m 444 /tmp/instruqt-agent.service /etc/systemd/system/instruqt-agent.service
rm -f /tmp/instruqt-agent.service
systemctl enable instruqt-agent.service

## Truncate /etc/machine-id
cat /dev/null > /etc/machine-id

## Remove any ssh host keys
rm -f /etc/ssh/ssh_host_*
