#!/bin/bash

set -euxo pipefail

# Give us access to the sandbox host from within the lab
# if we need to debug things

# Add iggy user
useradd -c "Iggy" -s /bin/bash -m -G google-sudoers iggy

# Create .ssh dir with correct permissions
install -d -o iggy -g iggy -m 700 ~iggy/.ssh

# Drop in the key defined in the secret IGGYS_SSH_PRIVATE_KEY_BASE64
# which we pass in as an environment variable when we run this
pushd ~iggy/.ssh
echo "${IGGYS_SSH_PRIVATE_KEY_BASE64}" | base64 -d > id_ed25519
chown iggy:iggy id_ed25519
chmod 400 id_ed25519
ssh-keygen -f id_ed25519 -y > id_ed25519.pub
cp id_ed25519.pub authorized_keys
chown iggy:iggy id_ed25519.pub authorized_keys
chmod 400 id_ed25519.pub authorized_keys
popd

exit 0
